# ==============================================================================
# LedgerLine - Backend Environment Variables
# Copy this file to `.env` in this directory and fill in your values.
# NEVER commit your actual `.env` file!
# ==============================================================================


# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 18.6)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledgerline_dev

# Runtime Application User (Used by Node.js server; cannot disable triggers, truncate tables, or modify ledger entries)
DB_USER=ledgerline_app
DB_PASSWORD=your_app_password_here

# Migration Runner Credentials (Used by npm run migrate:backend to execute DDL as schema owner)
# If omitted, migrate.js falls back to DB_USER and DB_PASSWORD.
MIGRATION_DB_USER=ledgerline_owner
MIGRATION_DB_PASSWORD=your_owner_password_here

# Alternatively, a connection URI (used if provided)
# DATABASE_URL=postgresql://ledgerline_app:your_password@localhost:5432/ledgerline_dev

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=24h

# Admin Bootstrap CLI (Used by npm run seed:admin for one-time initial administrator provisioning)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ledgerline.internal
ADMIN_PASSWORD=your_secure_admin_password_here

# Client Application URL (For CORS configuration)
CLIENT_URL=http://localhost:5173

# Redis Rate Limiting Configuration
# Optional: Full connection URI (e.g. redis://username:password@localhost:6379 or rediss:// for TLS)
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
RATE_LIMIT_ENABLED=true
