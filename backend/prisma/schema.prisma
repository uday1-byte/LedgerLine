generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  id                                                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_number                                       String                   @unique @db.VarChar(32)
  balance_paise                                        BigInt                   @default(0)
  created_at                                           DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                           DateTime                 @default(now()) @db.Timestamptz(6)
  account_type                                         String                   @default("customer") @db.VarChar(32)
  opening_balance_captured_at                          DateTime?                @db.Timestamptz(6)
  user_id                                              String?                  @db.Uuid
  phase6_cutover_balance_paise                         BigInt?
  phase6_cutover_captured_at                           DateTime?                @db.Timestamptz(6)
  next_entry_sequence                                  BigInt                   @default(1)
  users                                                users?                   @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  audit_refused_attempts                               audit_refused_attempts[]
  ledger_entries                                       ledger_entries[]
  transfers_transfers_destination_account_idToaccounts transfers[]              @relation("transfers_destination_account_idToaccounts")
  transfers_transfers_source_account_idToaccounts      transfers[]              @relation("transfers_source_account_idToaccounts")

  @@index([account_number], map: "idx_accounts_account_number")
  @@index([user_id], map: "idx_accounts_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_refused_attempts {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String?   @db.Uuid
  account_id             String?   @db.Uuid
  action                 String    @db.VarChar(32)
  attempted_amount_paise BigInt?
  reason_code            String    @db.VarChar(64)
  reason_message         String
  idempotency_key        String?   @db.VarChar(255)
  client_ip              String?   @db.VarChar(64)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  accounts               accounts? @relation(fields: [account_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users                  users?    @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([account_id, created_at(sort: Desc)], map: "idx_audit_refused_account")
  @@index([idempotency_key], map: "idx_audit_refused_idempotency")
  @@index([user_id, created_at(sort: Desc)], map: "idx_audit_refused_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model idempotency_keys {
  client_scope  String     @db.VarChar(128)
  key           String     @db.VarChar(255)
  request_hash  String     @db.VarChar(64)
  status        String     @db.VarChar(16)
  transfer_id   String?    @db.Uuid
  response_code Int?
  response_body Json?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)
  transfers     transfers? @relation(fields: [transfer_id], references: [id], onUpdate: NoAction)

  @@id([client_scope, key])
  @@index([created_at], map: "idx_idempotency_keys_created_at")
  @@index([transfer_id], map: "idx_idempotency_keys_transfer_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ledger_entries {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transfer_id            String    @db.Uuid
  account_id             String    @db.Uuid
  entry_type             String    @db.VarChar(8)
  amount_paise           BigInt
  balance_after_paise    BigInt
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  account_entry_sequence BigInt?
  accounts               accounts  @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  transfers              transfers @relation(fields: [transfer_id], references: [id], onUpdate: NoAction)

  @@unique([transfer_id, entry_type], map: "uq_transfer_entry_type")
  @@index([account_id, created_at(sort: Desc)], map: "idx_ledger_entries_account_id_created")
  @@index([transfer_id], map: "idx_ledger_entries_transfer_id")
}

