/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transfers {
  id                                                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_account_id                                   String             @db.Uuid
  destination_account_id                              String             @db.Uuid
  amount_paise                                        BigInt
  status                                              String             @default("completed") @db.VarChar(32)
  created_at                                          DateTime           @default(now()) @db.Timestamptz(6)
  transfer_type                                       String             @default("customer_transfer") @db.VarChar(32)
  original_transfer_id                                String?            @db.Uuid
  reversal_reason                                     String?
  created_by_user_id                                  String?            @db.Uuid
  idempotency_keys                                    idempotency_keys[]
  ledger_entries                                      ledger_entries[]
  users                                               users?             @relation(fields: [created_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accounts_transfers_destination_account_idToaccounts accounts           @relation("transfers_destination_account_idToaccounts", fields: [destination_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transfers                                           transfers?         @relation("transfersTotransfers", fields: [original_transfer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_transfers                                     transfers[]        @relation("transfersTotransfers")
  accounts_transfers_source_account_idToaccounts      accounts           @relation("transfers_source_account_idToaccounts", fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_by_user_id], map: "idx_transfers_created_by_user")
  @@index([destination_account_id], map: "idx_transfers_destination_account")
  @@index([source_account_id], map: "idx_transfers_source_account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username               String                   @unique @db.VarChar(64)
  email                  String                   @unique @db.VarChar(255)
  password_hash          String                   @db.VarChar(255)
  role                   String                   @default("account_holder") @db.VarChar(32)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  accounts               accounts[]
  audit_refused_attempts audit_refused_attempts[]
  transfers              transfers[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([username], map: "idx_users_username")
}
