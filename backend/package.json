{
  "name": "ledgerline-backend",
  "version": "1.0.0",
  "description": "Backend API for LedgerLine financial application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm install --include=dev && npm run prisma:generate",
    "postinstall": "prisma generate",
    "migrate": "node src/scripts/migrate.js",
    "migrate:production": "LEDGERLINE_ENV=production NODE_ENV=production MIGRATION_DB_USER=ledgerline_owner node src/scripts/migrate.js",
    "seed:admin": "node src/scripts/seed-admin.js",
    "seed:admin:production": "LEDGERLINE_ENV=production NODE_ENV=production MIGRATION_DB_USER=ledgerline_owner node src/scripts/seed-admin.js",
    "prisma:generate": "prisma generate",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "financial",
    "ledger",
    "express",
    "postgresql",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prisma": "^6.4.0",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
