# ==============================================================================
# LedgerLine - Environment Variables Example Template
# Copy this file to `.env` in the backend directory (or root) and fill in your values.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 18.6)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledgerline_dev
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Alternatively, a connection URI (used if provided)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ledgerline_dev

# Authentication & Security
# Generate a strong random secret: `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=24h

# Client Application URL (For CORS configuration)
CLIENT_URL=http://localhost:5173
